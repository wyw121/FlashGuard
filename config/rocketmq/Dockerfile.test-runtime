# Offline-cached base fallback when registry binary layers cannot be downloaded.
# Exact base digest and installed JRE version are recorded in benchmark metadata.
FROM node:18@sha256:c6ae79e38498325db67193d391e6ec1d224d96c693a8a4d943498556716d3783
RUN apt-get update && apt-get install -y --no-install-recommends openjdk-17-jre-headless=17.0.20.1+1-1~deb12u1 \
    && rm -rf /var/lib/apt/lists/*
