# Development-only values. Replace every password outside a disposable local environment.
FLASHGUARD_MYSQL_ROOT_PASSWORD=replace-with-local-root-password
FLASHGUARD_MYSQL_DATABASE=flashguard
FLASHGUARD_DB_USERNAME=flashguard
FLASHGUARD_DB_PASSWORD=replace-with-local-app-password
# Change to 3308 when another MySQL service already owns port 3306.
FLASHGUARD_MYSQL_PORT=3306
